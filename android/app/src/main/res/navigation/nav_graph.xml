<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.ytlibre.app.ui.home.HomeFragment"
        android:label="@string/nav_home">
        <action
            android:id="@+id/action_home_to_watch"
            app:destination="@id/watchFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.ytlibre.app.ui.search.SearchFragment"
        android:label="@string/nav_search">
        <action
            android:id="@+id/action_search_to_watch"
            app:destination="@id/watchFragment" />
        <action
            android:id="@+id/action_search_to_channel"
            app:destination="@id/channelFragment" />
    </fragment>

    <fragment
        android:id="@+id/libraryFragment"
        android:name="com.ytlibre.app.ui.library.LibraryFragment"
        android:label="@string/nav_library">
        <action
            android:id="@+id/action_library_to_watch"
            app:destination="@id/watchFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.ytlibre.app.ui.settings.SettingsFragment"
        android:label="@string/nav_settings" />

    <fragment
        android:id="@+id/watchFragment"
        android:name="com.ytlibre.app.ui.watch.WatchFragment"
        android:label="@string/nav_watch">
        <action
            android:id="@+id/action_watch_to_watch"
            app:destination="@id/watchFragment" />
        <action
            android:id="@+id/action_watch_to_channel"
            app:destination="@id/channelFragment" />
    </fragment>

    <fragment
        android:id="@+id/channelFragment"
        android:name="com.ytlibre.app.ui.channel.ChannelFragment"
        android:label="@string/nav_channel">
        <action
            android:id="@+id/action_channel_to_watch"
            app:destination="@id/watchFragment" />
    </fragment>
</navigation>
