# Copiez ce fichier vers « .env » (jamais versionné) puis renseignez la clé.
# Console : https://console.cloud.google.com/apis/credentials
#   1. projet → APIs et services → Bibliothèque → « YouTube Data API v3 » → Activer
#   2. Identifiants → Créer des identifiants → Clé API
#   3. restreindre la clé : API « YouTube Data API v3 » + package Android
#
# Quota gratuit : 100 recherches/jour (search.list) + 10 000 unités/jour (autres).
YOUTUBE_API_KEY=AIza...

# Code pays des tendances / résultats (facultatif)
YOUTUBE_REGION=FR
